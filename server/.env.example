# ── Required in production ──────────────────────────────────────────────
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret-here

# Comma-separated list of allowed origins (no spaces around commas)
# Example: https://kaarya.app,https://www.kaarya.app
ALLOWED_ORIGINS=https://kaarya.app,https://www.kaarya.app

# ── Optional ─────────────────────────────────────────────────────────
PORT=5000

# JWT expiry (default: 7d)
# JWT_EXPIRY=7d

# Bcrypt rounds — higher = safer but slower (default: 10)
# BCRYPT_ROUNDS=10

# ── Mailtrap (email) ────────────────────────────────────────────────
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_password

# ── Firebase Admin SDK (push notifications) ──────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
