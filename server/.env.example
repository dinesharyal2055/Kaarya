# ── Required in production ──────────────────────────────────────────────
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-64-char-hex-secret-here

# Comma-separated list of allowed origins (no spaces around commas)
# Example: https://kaarya.app,https://www.kaarya.app
ALLOWED_ORIGINS=https://kaarya.app,https://www.kaarya.app

# ── Optional ─────────────────────────────────────────────────────────
PORT=5000

# JWT expiry (default: 7d)
# JWT_EXPIRY=7d

# Bcrypt rounds — higher = safer but slower (default: 10)
# BCRYPT_ROUNDS=10

# Demo account password (local development only)
# DEMO_PASSWORD=your-demo-password

# Admin demo account (local development only)
# ADMIN_EMAIL=admin@kaarya.demo
# ADMIN_PASSWORD=your-admin-password

# ── Resend (email) ─────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# From email address - must be verified in Resend
# For testing, use: onboarding@resend.dev (pre-verified by Resend)
FROM_EMAIL=onboarding@resend.dev

# ── Firebase Admin SDK (push notifications) ──────────────────────────
# Option A: Env vars (recommended — keeps credentials off disk)
# FIREBASE_PROJECT_ID=kaarya-production
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   (use \n for newlines — the code replaces them automatically)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kaarya-production.iam.gserviceaccount.com
#
# Option B: JSON file (already in .gitignore)
# FCM_SERVICE_ACCOUNT_PATH=./server/src/firebase-service-account.json
